  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Windmill blades, more accurately called wind turbine blades, are the large,
    aerodynamically shaped structures that capture the kinetic energy of moving air.
    Their curved design works like an airplane wing: as wind flows across the blade,
    differences in air pressure create lift, causing the blades to rotate around
    a central hub.\n\nThis rotation turns a shaft connected to a generator, converting
    the wind\u2019s natural motion into clean, renewable electricity. The shape,
    size, and angle of the blades determine how efficiently a wind turbine can capture
    energy from the wind.\n\nModern blades are made from strong, lightweight materials
    such as fiberglass or carbon\u2011fiber composites, allowing them to withstand
    powerful winds while spinning smoothly and safely."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
