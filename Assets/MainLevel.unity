  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hydroelectric energy is the production of electricity using the natural
    movement of water, a renewable resource that is continuously replenished by Earth\u2019s
    water cycle. A hydroelectric dam stores water in a reservoir and releases it
    through large channels called penstocks.\n\nAs water flows downward, gravity
    accelerates it, causing it to spin a turbine\u2014a wheel with precisely shaped
    blades. The spinning turbine turns a generator, which converts the water\u2019s
    kinetic energy into clean, reliable electrical power.\n\nBecause the water cycle
    is driven by the Sun and constantly renewed through evaporation and rainfall,
    hydroelectric dams provide a steady, long\u2011term, low\u2011emission source
    of renewable energy used worldwide."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
